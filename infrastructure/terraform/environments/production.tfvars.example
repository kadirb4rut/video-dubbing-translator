aws_region = "eu-north-1"
name       = "lingowave"
deployment_mode = "serverless"
serverless_frontend_cutover = false # Set true only after Aurora migration and direct API Gateway validation.

# Fill these with immutable ECR image digests before apply.
worker_image = ""
api_image    = ""
lambda_api_image = ""
# Existing production migration phase only: set retain_legacy_api=true and
# api_image to the current legacy digest, plus api_secrets, until Lambda is
# validated. Set both retain flags to false only in the later cleanup phase.
retain_legacy_api = true

create_network       = true
frontend_enabled     = true
frontend_dist_dir    = "../../frontend/dist"
frontend_origin      = "https://replace-with-the-frontend-origin"
api_desired_count    = 1
worker_desired_count = 0
cost_alert_email     = "replace-with-cost-alert-email@example.com"
monthly_cost_budget_usd = 25
worker_instance_type = "g4dn.xlarge"
cpu_worker_ephemeral_storage_gib = 50
# Keep on-demand until Spot interruption recovery is accepted in the target region.
gpu_market_type      = "on-demand"
# Phase A uses the measured CPU fleet. The GPU image remains present at
# desired=0 so quota approval can later switch the active fleet without
# deleting the GPU rollback architecture.
worker_compute_mode = "cpu"
worker_max_count    = 10
cpu_worker_max_count = 1 # Current account evidence shows a 4096-CPU Fargate task; raise only after quota verification.
worker_scale_in_evaluation_periods = 2 # Keep the queue empty for two one-minute samples before scale-in.
worker_scale_in_cooldown_seconds = 60
cpu_worker_image    = ""
enable_rds           = false
retain_legacy_rds   = true # Existing production migration phase only; set false after Aurora is verified.
enable_aurora_serverless = true
aurora_provisioning_mode = "terraform-vpc" # Free plan fallback: express-existing with externally bootstrapped ARNs.
aurora_engine_version = "16.8"
aurora_max_acu = 1
aurora_auto_pause_seconds = 300
translation_provider = "google-deep-translator"
translation_refinement_provider = "hymt2"
voxcpm_allow_download = true # First CPU validation task must fetch the pinned model; prewarm/cache it before production hardening.

# Set these only after a verified sender/domain and Stripe catalog exist.
mail_provider = "ses"
mail_from     = "replace-with-a-verified-sender"
ses_identity_arn = "replace-with-the-verified-ses-identity-arn"

# Keep secret values out of tfvars. Serverless Lambda loads these names from
# SSM Parameter Store Standard at cold start. The Aurora-managed DB credential
# remains in Secrets Manager because the RDS Data API requires its secret ARN.
worker_secrets = {}
api_secrets    = {}
ssm_parameter_map = {
  GOOGLE_CLIENT_ID              = "/lingowave/production/google-client-id"
  GOOGLE_CLIENT_SECRET          = "/lingowave/production/google-client-secret"
  GOOGLE_REDIRECT_URI           = "/lingowave/production/google-redirect-uri"
  STRIPE_SECRET_KEY             = "/lingowave/production/stripe-secret-key"
  STRIPE_WEBHOOK_SECRET         = "/lingowave/production/stripe-webhook-secret"
  STRIPE_SUCCESS_URL            = "/lingowave/production/stripe-success-url"
  STRIPE_CANCEL_URL             = "/lingowave/production/stripe-cancel-url"
  STRIPE_BILLING_PORTAL_RETURN_URL = "/lingowave/production/stripe-portal-return-url"
  STRIPE_PRICE_CREATOR          = "/lingowave/production/stripe-price-creator"
  STRIPE_PRICE_PRO              = "/lingowave/production/stripe-price-pro"
  STRIPE_PRICE_STUDIO           = "/lingowave/production/stripe-price-studio"
  STRIPE_PRICE_CREDITS_STARTER  = "/lingowave/production/stripe-price-credits-starter"
  STRIPE_PRICE_CREDITS_GROWTH   = "/lingowave/production/stripe-price-credits-growth"
  STRIPE_PRICE_CREDITS_SCALE    = "/lingowave/production/stripe-price-credits-scale"
}
ssm_parameter_arns = []
