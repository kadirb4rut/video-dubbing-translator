FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV HOME=/home/lingowave
ENV XDG_CACHE_HOME=/home/lingowave/.cache
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 cargo && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt backend/requirements.worker-common.txt backend/requirements.worker-cpu.txt backend/requirements.worker-cpu-full.txt backend/requirements.worker-gpu.txt ./
ARG WORKER_REQUIREMENTS=requirements.worker-cpu.txt
ARG INSTALL_CHATTERBOX=false
RUN python -m pip install --no-cache-dir --upgrade "pip>=26.2" "setuptools>=83" \
    && python -m pip install --no-cache-dir -r ${WORKER_REQUIREMENTS} \
    && if [ "${INSTALL_CHATTERBOX}" = "true" ]; then \
         python -m pip install --no-cache-dir --no-deps chatterbox-tts==0.1.7; \
       fi
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY config ./config
RUN addgroup --system lingowave && adduser --system --ingroup lingowave lingowave \
    && mkdir -p /app/data /home/lingowave/.cache \
    && chown -R lingowave:lingowave /app /home/lingowave
USER lingowave
CMD ["python", "-m", "app.worker"]
