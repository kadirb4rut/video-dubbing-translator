FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN python -m pip install --no-cache-dir --upgrade "pip>=26.2" "setuptools>=83" \
    && python -m pip install --no-cache-dir -r requirements.txt

COPY scripts/migrate_postgres_to_aurora_data_api.py ./scripts/migrate_postgres_to_aurora_data_api.py

ENTRYPOINT ["python", "/app/scripts/migrate_postgres_to_aurora_data_api.py"]
